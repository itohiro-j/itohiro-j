# ==============================================================
# 毎日の計画自動化システム — 設定ファイルテンプレート
# このファイルを config.env としてコピーして使用してください
# cp config.env.example config.env
# ==============================================================

# ----------------------------------------------------------------
# GitHub 設定（任意）
# 設定しない場合は GitHub Issues の取得をスキップします
# ----------------------------------------------------------------

# GitHub Personal Access Token（read:org + repo スコープが必要）
GITHUB_TOKEN=

# アサインIssueを取得するユーザー名
GITHUB_USER=

# 取得するリポジトリ（カンマ区切り。例: owner/repo,owner/repo2）
# 空の場合はGITHUB_USERにアサインされたIssueを全リポジトリから取得
GITHUB_REPOS=

# ----------------------------------------------------------------
# Slack 設定
# ----------------------------------------------------------------

# --- Slack Bot（インタラクティブボタン用）---
# Slack App を作成して以下のトークンを取得してください
# 詳細は README.md の「Slack App のセットアップ」を参照

# Bot User OAuth Token（xoxb- で始まるトークン）
# 必要スコープ: chat:write, im:read, im:write, app_mentions:read
SLACK_BOT_TOKEN=

# App-Level Token（xapp- で始まるトークン）
# Socket Mode の有効化と connections:write スコープが必要
SLACK_APP_TOKEN=

# ボットからメッセージを投稿するデフォルトチャンネル
# 例: C1234567890（チャンネルIDを使用）または #daily-plan
SLACK_CHANNEL=

# --- Incoming Webhook（シンプルな通知のみの場合）---
# Slack Bot を使う場合は不要
SLACK_WEBHOOK_URL=

# --- スケジュール通知（任意）---
# 朝のリマインダーを自動投稿する時刻（HH:MM, 24時間形式, Asia/Tokyo）
# 空にすると自動投稿をしない
SLACK_MORNING_REMINDER=09:00

# 夕方のリマインダーを自動投稿する時刻
SLACK_EVENING_REMINDER=18:00

# ----------------------------------------------------------------
# 動作設定
# ----------------------------------------------------------------

# バックログからの昇格日数（何日以内の締切なら今日のタスクに昇格するか）
BACKLOG_PROMOTE_DAYS=3

# 朝の計画のタイムゾーン
TZ=Asia/Tokyo

# 優先順位スコアの重み（調整可能）
W_PRIORITY=4    # 優先度マーカー (A/B/C) の重み
W_URGENCY=5     # 締切の緊急度の重み
W_LABEL=3       # ラベル (#high/#medium/#low) の重み
W_BUG_BOOST=2   # +bug カテゴリのボーナス重み

# ----------------------------------------------------------------
# 計画ファイル設定
# ----------------------------------------------------------------

# 計画ファイルの保存先
PLANS_DIR=plans

# レポートファイルの保存先
REPORTS_DIR=reports

# タスクディレクトリ
TASKS_DIR=tasks

# git auto-commit（evening.sh 実行時に自動コミットするか）
GIT_AUTO_COMMIT=true
